---
import "../styles/global.css";
import { profile } from "../data/content";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/assets/og-image.png", Astro.site);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Luis Enrique Ramírez López",
  alternateName: "Luis Ramírez",
  url: Astro.site?.href,
  image: ogImageURL.href,
  jobTitle: "Founder, CEO & CTO",
  worksFor: {
    "@type": "Organization",
    name: "Iruz Labs",
    url: "https://iruzlabs.com",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Chimalhuacán",
    addressRegion: "Estado de México",
    addressCountry: "MX",
  },
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  sameAs: [profile.linkedin, profile.github, "https://iruzlabs.com"],
  knowsAbout: [
    "Artificial Intelligence",
    "Autonomous AI Agents",
    "Distributed Systems",
    "Microservices",
    "AWS",
    "Event-driven Architecture",
    "LLMs",
  ],
};

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Iruz Labs",
  url: "https://iruzlabs.com",
  founder: {
    "@type": "Person",
    name: "Luis Enrique Ramírez López",
  },
  description:
    "Plataforma omnicanal de agentes autónomos de IA (AAaaS) para ventas y seguimiento por WhatsApp, Instagram, Facebook, TikTok, SMS, Telegram y voz.",
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#072146" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Luis Enrique Ramírez López" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data (AEO: Person + Organization) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

    <noscript>
      <style>
        #preloader {
          display: none !important;
        }
        .hero-intro > * {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var storedTheme = localStorage.getItem("theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            root.setAttribute("data-theme", storedTheme);
          }

          var storedLang = localStorage.getItem("lang");
          var lang = storedLang;
          if (!lang) {
            lang = navigator.language && navigator.language.toLowerCase().indexOf("en") === 0 ? "en" : "es";
          }
          root.setAttribute("data-lang", lang);
          root.setAttribute("lang", lang);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="preloader" class="preloader" role="presentation">
      <div class="preloader-glass">
        <span id="preloader-word" class="preloader-word">Hola</span>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById("preloader");
        var wordEl = document.getElementById("preloader-word");
        if (!el || !wordEl) return;

        var greetings = ["Hola", "Hi", "Bonjour", "Ciao", "Hallo", "Olá", "こんにちは", "你好", "Namaste"];
        var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.body.style.overflow = "hidden";

        function finalGreeting() {
          return document.documentElement.getAttribute("data-lang") === "en" ? "Hi" : "Hola";
        }

        function setWord(text) {
          wordEl.textContent = text;
          wordEl.classList.remove("is-animating");
          void wordEl.offsetWidth;
          wordEl.classList.add("is-animating");
        }

        function hidePreloader() {
          el.classList.add("preloader-hidden");
          document.body.classList.add("is-ready");
          document.body.style.overflow = "";
          window.setTimeout(function () {
            el.setAttribute("hidden", "");
          }, 650);
        }

        el.addEventListener("click", function () {
          window.clearInterval(cycleId);
          hidePreloader();
        });

        if (reduceMotion) {
          setWord(finalGreeting());
          window.setTimeout(hidePreloader, 500);
          return;
        }

        var i = 0;
        var cycleId = window.setInterval(function () {
          i++;
          if (i >= greetings.length) {
            window.clearInterval(cycleId);
            setWord(finalGreeting());
            window.setTimeout(hidePreloader, 550);
            return;
          }
          setWord(greetings[i]);
        }, 160);
      })();
    </script>
    <slot />
    <script is:inline>
      (function () {
        function currentTheme() {
          var root = document.documentElement;
          var attr = root.getAttribute("data-theme");
          if (attr === "light" || attr === "dark") return attr;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }

        function toggleTheme() {
          var next = currentTheme() === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        }

        function toggleLang() {
          var root = document.documentElement;
          var next = root.getAttribute("data-lang") === "en" ? "es" : "en";
          root.setAttribute("data-lang", next);
          root.setAttribute("lang", next);
          try {
            localStorage.setItem("lang", next);
          } catch (e) {}
        }

        document.querySelectorAll("[data-action='toggle-theme']").forEach(function (btn) {
          btn.addEventListener("click", toggleTheme);
        });

        document.querySelectorAll("[data-action='toggle-lang']").forEach(function (btn) {
          btn.addEventListener("click", toggleLang);
        });

        document.querySelectorAll("[data-action='toggle-nav']").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var target = document.getElementById(btn.getAttribute("aria-controls"));
            if (!target) return;
            var isOpen = target.classList.toggle("is-open");
            btn.setAttribute("aria-expanded", isOpen ? "true" : "false");
          });
        });

        document.querySelectorAll(".nav-links a").forEach(function (link) {
          link.addEventListener("click", function () {
            document.querySelectorAll(".nav-links.is-open").forEach(function (nav) {
              nav.classList.remove("is-open");
            });
          });
        });

        var revealTargets = document.querySelectorAll(".reveal");
        if (!("IntersectionObserver" in window) || !revealTargets.length) {
          revealTargets.forEach(function (el) {
            el.classList.add("is-visible");
          });
        } else {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
          );
          revealTargets.forEach(function (el) {
            observer.observe(el);
          });
        }

        var reduceMotionForTimeline =
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var timelineTargets = document.querySelectorAll(".timeline-card");
        if (!("IntersectionObserver" in window) || reduceMotionForTimeline || !timelineTargets.length) {
          timelineTargets.forEach(function (el) {
            el.classList.add("is-visible");
          });
        } else {
          var timelineObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                entry.target.classList.toggle("is-visible", entry.isIntersecting);
              });
            },
            { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
          );
          timelineTargets.forEach(function (el) {
            timelineObserver.observe(el);
          });
        }
      })();
    </script>
  </body>
</html>
