---
import type { LangContent } from "../data/content";

interface Props {
  content: LangContent;
}

const { content } = Astro.props;
---

<section class="section" id="about">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{content.nav.about}</span>
      <h2 class="section-title">{content.about.title}</h2>
    </div>
    <div class="about-grid">
      <p class="about-text">{content.about.paragraph}</p>
    </div>
  </div>
</section>
