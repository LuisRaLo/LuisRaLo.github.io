---
import type { LangContent } from "../data/content";
import { profile } from "../data/content";

interface Props {
  content: LangContent;
}

const { content } = Astro.props;
---

<section class="section" id="contact">
  <div class="container">
    <div class="contact-card">
      <div>
        <span class="eyebrow">{content.nav.contact}</span>
        <h2 class="section-title">{content.contact.title}</h2>
        <p class="contact-text">{content.contact.text}</p>
        <a class="btn btn-primary contact-cv" href={profile.cv} download>{content.contact.cvLabel}</a>
      </div>

      <div class="contact-list">
        <a class="contact-row" href={`tel:${profile.phone.replace(/\s+/g, "")}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <div>
            <div class="contact-row-label">{content.contact.phoneLabel}</div>
            <div class="contact-row-value">{profile.phone}</div>
          </div>
        </a>

        <a class="contact-row" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16v16H4z" opacity="0"></path>
            <path d="M22 6l-10 7L2 6"></path>
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
          </svg>
          <div>
            <div class="contact-row-label">{content.contact.emailLabel}</div>
            <div class="contact-row-value">{profile.email}</div>
          </div>
        </a>

        <div class="contact-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <div class="contact-row-label">{content.contact.locationLabel}</div>
            <div class="contact-row-value">{profile.location}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
